# Prompt uretimi saglayicisi: claude (varsayilan) | mock
# mock: Anthropic'e hic istek gitmez, ANTHROPIC_API_KEY/kredi gerekmez
PROMPT_PROVIDER=claude

# PROMPT_PROVIDER=claude icin zorunlu
ANTHROPIC_API_KEY=sk-ant-...

# Gorsel uretimi saglayicisi: mock | huggingface | openai | stability
# mock: anahtar gerekmez, yer tutucu gorsel doner
IMAGE_PROVIDER=mock

# IMAGE_PROVIDER=openai icin
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1

# IMAGE_PROVIDER=huggingface icin
# HF_API_KEY=hf_...
# HF_MODEL=stabilityai/stable-diffusion-2
# HF_API_BASE=https://api-inference.huggingface.co/models

# IMAGE_PROVIDER=stability icin
# STABILITY_API_KEY=sk-...

PORT=3000
